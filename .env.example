# Generated development defaults: python scripts/setup.py
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-generated-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_CORS_ALLOWED_ORIGINS=
ALLOW_REGISTRATION=0
TOKEN_TTL_HOURS=168
# Leave DATABASE_URL and REDIS_URL empty for local SQLite and memory cache.
DATABASE_URL=
REDIS_URL=
# Production must set debug=0, a real secret, hostnames, Postgres and Redis.
PUBLIC_BASE_URL=http://localhost:8000
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=stackquay@localhost
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
